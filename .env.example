# ThingSpeak MQTT Configuration
# Obtain these credentials from your ThingSpeak account
# Instructions: https://www.mathworks.com/help/thingspeak/mqtt-api.html

THINGSPEAK_CHANNEL_ID=your_channel_id_here
THINGSPEAK_MQTT_CLIENT_ID=your_client_id_here
THINGSPEAK_MQTT_USERNAME=your_username_here
THINGSPEAK_MQTT_PASSWORD=your_password_here
THINGSPEAK_MQTT_HOST=mqtt3.thingspeak.com
THINGSPEAK_MQTT_PORT=8883

# Ascon-128 Encryption Settings
# Key must be exactly 16 bytes (128 bits)
ASCON_KEY=asconciphertest1
# Nonce prefix (will be combined with timestamp+sequence for uniqueness)
ASCON_NONCE_PREFIX=asconcipher1test
ASCON_VARIANT=Ascon-128

# Audio Settings for Subscriber
AUDIO_SAMPLE_RATE=8000
AUDIO_CHANNELS=1
AUDIO_BITS_PER_SAMPLE=16
